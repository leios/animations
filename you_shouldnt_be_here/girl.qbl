/*-------------girl.qbl-------------------------------------------------------//

 Purpose: To draw a decent render of a girl

   Notes: 1. Define the eyes extents so if the iris moves beyond this location
             it will disappear
          2. eyebrows

//----------------------------------------------------------------------------*/
@include "QB/chaos.qbl"

/*----------------------------------------------------------------------------//
    EYES
//----------------------------------------------------------------------------*/

bool in_eye_extents(quibble_point_2D pt,
                    bool left_eye,
                    float eye_size,
                    float eye_separation){
    
    // move to center and do transformations for eye shape
    pt.x - eye_separation*0.5;
    pt.y *= 2 + pt.x;

    // right eye
    float radius = sqrt((pt.x-eye_separation*0.5)*(pt.x-eye_separation*0.5)
                         +pt.y*pt.y);

    if (radius < 2*eye_size){
        return true;
    }

    pt.x *= -1;

    radius = sqrt((pt.x-eye_separation*0.5)*(pt.x-eye_separation*0.5)
                   +pt.y*pt.y);


    // left eye
/*
    float radius = 0;
    if (left_eye){
        radius = sqrt((pt.x-eye_separation*0.5)*(pt.x-eye_separation*0.5)
                       +pt.y*pt.y);
    } else {
        radius = sqrt((pt.x+eye_separation*0.5)*(pt.x+eye_separation*0.5)
                       +pt.y*pt.y);
    }
*/

    if (radius < 2*eye_size){
        return true;
    } else {
        return false;
    }
}

__verse reflection(quibble_point_2D pt |
                   float eye_size = 0.25; int num_ignore = 20;
                   float openness = 1; float separation = 0.25;){

    quibble_pcolor_rgba8888 reflection_color = qb_pcolor_rgba8888(1,1,1,1,0.6);

    // constructing smaller circle
    pt.x *= 0.15;
    pt.y *= 0.15;

    // shifting to the right
    pt.x += 0.5;

    float r = sqrt(pt.x*pt.x + pt.y*pt.y);
    float theta = atan2(pt.y, pt.x);

    // smearing angularly
    theta *= 2;
 
    // rotating to the right position
    theta -= 0.75*M_PI;

    pt.x = r*cos(theta);
    pt.y = r*sin(theta);

    pt.x *= eye_size;
    pt.y *= eye_size;

    pt.x += separation*0.5;

    if (_i > num_ignore){
        histogram_output_prgba8888(pt, reflection_color, qcam, qpix);
        pt.x -= separation;
        histogram_output_prgba8888(pt, reflection_color, qcam, qpix);
    }

}

quibble_point_2D iris_jitter(quibble_point_2D pt, float time, float eye_size){
    pt.x += 0.1*eye_size*sin(time*10*M_PI);
    pt.y += 0.1*eye_size*cos(time*5*M_PI);
/*
    if (time < 0.15){;
        pt.x += 0.25*eye_size*time/0.15;
    } else if (time >= 0.15 && time < 0.3){
        pt.x += 0.25 - 0.25*eye_size*(time-0.15)/0.15;
        pt.y += 0.25*eye_size*(time-0.15)/0.15;
    } else if (time >= 0.3 && time < 0.6){
        pt.y += 0.25 - 0.25*eye_size*(time-0.15)/0.15;
    }
*/
    return pt;
}

float find_pupil_size(float base_size, float time){

    if (time < 0.5){
        return base_size + 0.1*time*2;
    } else {
        return 0.4;
    }

    return base_size;
}

__verse iris(quibble_point_2D pt, float time | 
             float color_change = 0.1;
             float eye_size = 0.25;
             int num_ignore = 20;
             float openness = 1;
             float separation = 0.5;){

    float pupil_size = find_pupil_size(0.3, time);

    float iris_priority = 0.5;

    quibble_pcolor_rgba8888 iris_color =
        qb_pcolor_rgba8888(0,0,0,0,iris_priority);

    float r = sqrt(pt.x*pt.x + pt.y*pt.y);
    float theta = atan2(pt.y,pt.x);

    // This modifies the color change line (where the two colors mix
    // we are using a combo of different cos values to make a somewhat rng 
    //     line pattern
    color_change = pupil_size + (1-pupil_size)*color_change;
    color_change = (color_change - pupil_size)*(1.25-0.25*cos(10*theta)*cos(20*theta))+pupil_size;

    // initial coloring
    if (r <= pupil_size){
        iris_color = qb_pcolor_rgba8888(0,0,0,1,
                                        iris_priority);
    }
    else if (r <= color_change){
        float theta_shading = (1 - 0.05*cos(13*theta)*cos(27*theta));
        iris_color = qb_pcolor_rgba8888(1*theta_shading,
                                        0.75*theta_shading,
                                        0*theta_shading,
                                        1,
                                        iris_priority);
    }
    else{
        float theta_shading = (1 - 0.1*cos(20*theta)*cos(10*theta));
        iris_color = qb_pcolor_rgba8888((1-r)*theta_shading,
                                        (1-r)*theta_shading,
                                        (0.5 + 0.5*(1-r))*theta_shading,
                                        1,
                                        iris_priority);
    }

    // resize eye. remove later
    pt.x *= eye_size;
    pt.y *= eye_size;

    pt.x += separation*0.5;

    if (_i > num_ignore){
        histogram_output_prgba8888(iris_jitter(pt, time, eye_size),
                                   iris_color, qcam, qpix);
        pt.x *= -1;
        histogram_output_prgba8888(iris_jitter(pt, time, eye_size),
                                   iris_color, qcam, qpix);
    }
}

// Much of this verse relies on the rectangle being centered about the origin
//     from -1 -> 1
__verse eyelash(quibble_point_2D pt, quibble_pcolor_rgba8888 eyelash_color |
                int num_ignore = 20; float openness = 1; int num_lashes = 5;
                float eye_size = 0.5; float separation = 0.5;){

    quibble_point_2D cat_eye_pt = pt;

    float s = sign(openness);

    // eye lashes
    if (num_lashes > 0){
        // num_lashes - 0.5 so it ends on a cat-eye
        float lash_length = 2.0/(num_lashes);

        // centering eyelash
        pt.x += 1;
        pt.y -= s*0.05;

        // extending so modulo function later can be % 1
        pt.x /= lash_length;

        // offsetting by 0.5 so the peaks connect
        pt.x += 0.5;

        // creating lashes
        float m = fmod(pt.x, 1.0f);

        // subtracting 0.5 from modulo operator so the range is from -0.5 -> 0.5
        m -= 0.5;

        // 10 is arbitrary
        pt.y *= 1 + s*10*openness*m*m;

        // eye shaping
        pt.y += s*0.05;
        pt.y *= 1-pow((float)((pt.x-0.5)*lash_length)-1.0f,2.0f);
        pt.y -= s*0.05;
        //pt.y *= 0.1 + 0.2*pt.x;

        /*
        if (pt.x >  (num_lashes - 1)){
            float new_x = pt.x - num_lashes + 1;
            pt.y *= (1 + new_x);
            pt.y += s*0.05*new_x * new_x*new_x*new_x*openness;
            //pt.y *= 1 - new_x;
        }
        */

        // shifting lashes a bit to the right as the go up for effect
        pt.x -= s*3*(pt.y+s*0.05)*(pt.y+s*0.05)*(pt.y+s*0.05);

        // returning to original position
        pt.x -= 0.5;
        pt.x *= lash_length;
        pt.x -= 1;
        pt.y += s*0.05;
    }

    // eye shaping
    //pt.y*=(1-pt.x*pt.x);
    //pt.y *= (0.5-pt.x*pt.x);

    pt.y -= 0.5*openness;
    pt.x += 0.25;

    float r = sqrt(pt.x*pt.x + pt.y*pt.y);
    //float theta = atan2(pt.y,pt.x);

    pt.y += openness * 0.2*r;

    pt.x *= eye_size*2;
    pt.y *= eye_size*2;

    pt.x += separation*0.5;

/*
    float curve_pt = eye_size + 0.25;
    if (pt.x > curve_pt){
        pt.y += 0.5*(pt.x-curve_pt)*r*r;
    }
*/

    if (_i > num_ignore){
        histogram_output_prgba8888(pt, eyelash_color, qcam, qpix);
        pt.x *= -1;
        histogram_output_prgba8888(pt, eyelash_color, qcam, qpix);
    }
}

__verse eye_shadow(quibble_point_2D pt, quibble_pcolor_rgba8888 clr |
                   float openness = 1; float eye_size = 0.5;
                   int num_ignore = 20; float separation = 0.5;){

    // for now, flipping all points up, but might also use this to block out eye for the under lashes too
    pt.y = -fabs(pt.y);

    pt.y /= (1+0.2*openness);

    // creating an upper semi-circle under the lashes
    pt.y -= 0.5*openness;
    pt.x += 0.25;

    float r = sqrt(pt.x*pt.x + pt.y*pt.y);
    //float theta = atan2(pt.y,pt.x);

    pt.y += openness * 0.2*r;

    pt.y *= eye_size*2;
    pt.x *= eye_size*2;

    pt.x += 0.5*separation;

    if (_i > num_ignore){
        histogram_output_prgba8888(pt, clr, qcam, qpix);
        pt.x *= -1;
        histogram_output_prgba8888(pt, clr, qcam, qpix);
    }
}

// This assumes the eyebrow is from 0 -> 2 in x
quibble_point_2D eyebrow_shaping(quibble_point_2D pt, float time){

    if (time < 0.5){
        pt.y -= 0.5*pt.x*pt.x*time;
        pt.y += time;
    }
    else {
        pt.y -= 0.25*pt.x*pt.x;
        pt.y += 0.5;
    }

    return pt;
}

__verse eyebrow(quibble_point_2D pt, quibble_pcolor_rgba8888 clr,
                float time | 
                float eye_size = 0.25; float separation = 0.5;
                int num_ignore = 20;){

    pt.y *= (1-(pt.x*pt.x));

    // centers eyebrow from 0->2
    pt.x += 1;
    pt.y += 0.1*pt.x*pt.x;

    pt = eyebrow_shaping(pt, time);

    // brings brow back a bit, but not fully to avoid unibrow.
    pt.x -= 0.5;

    // resizing
    pt.x *= eye_size*2;
    pt.y *= eye_size*2;

    // separates and raises brow
    pt.x += 0.5*separation;
    pt.y -= eye_size * 3;

    if (_i > num_ignore){
        histogram_output_prgba8888(pt, clr, qcam, qpix);
        pt.x *= -1;
        histogram_output_prgba8888(pt, clr, qcam, qpix);
    }

}

/*----------------------------------------------------------------------------//
    FACE
//----------------------------------------------------------------------------*/

quibble_pcolor_rgba8888 base_face_color(){
    return qb_pcolor_rgba8888(0.95, 0.75, 0.85, 1, 0.3);
}
quibble_pcolor_rgba8888 face_color(quibble_point_2D pt,
                                   float eye_size,
                                   float eye_separation){

    
    // left eye
    if (in_eye_extents(pt, true, eye_size, eye_separation) || 
        in_eye_extents(pt, false, eye_size, eye_separation)){
        return qb_pcolor_rgba8888(1,1,1, 1, 0.3);
    }
    return base_face_color();
}

__verse head(quibble_point_2D pt | int num_ignore = 20;
             float eye_size = 0.25; float eye_separation = 0.5;){

    pt.x *= 0.65 - 0.1*pt.y;
    if (pt.y < 0){
        pt.y *= 0.7;
    } else{
        pt.x = pt.x*(5 - pt.y*pt.y) / 5;
        pt.y *= 0.8;
    }

    if (_i > num_ignore){
        histogram_output_prgba8888(pt, face_color(pt, eye_size, eye_separation),
                                   qcam, qpix);
    }
}

__poem girl(quibble_pixels_prgba8888 qpix,
            quibble_simple_camera qcam,
            float time){

    quibble_pcolor_rgba8888 qcolor = qb_pcolor_rgba8888(1,0,1,1,0.1);

    /*------------------------------------------------------------------------//
        FACE
    //------------------------------------------------------------------------*/

    // variables for defining face color and eye bg
    float eye_size = 0.1;
    float eye_separation = 0.5;

    @SCALL circle_chaos(1000, qcam, qcolor | radius = 1;){
        @VCALL head(_pt |
                    float eye_size = eye_size;
                    float eye_separation = eye_separation;);
    }

    /*------------------------------------------------------------------------//
        EYES
    //------------------------------------------------------------------------*/
    quibble_pcolor_rgba8888 eyelash_color = qb_pcolor_rgba8888(0,0,0,1,0.8);

    quibble_pcolor_rgba8888 eye_shadow_color = base_face_color();
    eye_shadow_color.priority = qb_color_clamp(0.7, 0, 1);
    //quibble_pcolor_rgba8888 eye_shadow_color =
    //    qb_pcolor_rgba8888(1,0.75,1,1,0.7);
    //quibble_pcolor_rgba8888 eye_shadow_color =
        //qb_pcolor_rgba8888(0.9,0.75,1,1,0.7);

    quibble_pcolor_rgba8888 eyebrow_color = 
        qb_pcolor_rgba8888(0.5, 0.25, 0.15, 1, 0.8);

    float openness = 2;
    if (time < 0.15){
        openness = 2-4*time/0.15;
    } else if (time >= 0.15 && time < 0.3) {
        openness = -2+4*(time-0.15)/0.15;
    } else if (time >= 0.45 && time < 0.6){
        openness = 2-4*(time-0.45)/0.15;
    } else if (time >= 0.6 && time < 0.75){
        openness = -2+4*(time-0.6)/0.15;
    }


    @SCALL circle_chaos(1000, qcam, qcolor | radius = 1;){
        @VCALL iris(_pt, time | float eye_size = eye_size;
                    float separation = eye_separation;);
        @VCALL reflection(_pt | float eye_size = eye_size;
                                float separation = eye_separation;);
        @VCALL eye_shadow(_pt, eye_shadow_color |
                          float openness = openness;
                          float eye_size = eye_size;
                          float separation = eye_separation;);
    }

    @SCALL rectangle_chaos(100, qcam, qcolor | float scale_y = 0.05;){
        @VCALL eyelash(_pt, eyelash_color |
                       float openness = openness;
                       float eye_size = eye_size;
                       float separation = eye_separation;);
        @VCALL eyebrow(_pt, eyebrow_color, time |
                       float eye_size = eye_size;
                       float separation = eye_separation;);
    }



}
