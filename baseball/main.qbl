@include "QB/chaos.qbl"
@include "QB/output.qbl"

#define CENTER_TIME 0.5
#define APEX_TIME 1
#define HANG_TIME 0.25
// HIT_TIME APEX_TIME + HANG_TIME + 1
#define HIT_TIME 2.25
#define IMPACT_TIME 0.1
// FLY_TIME HIT_TIME + IMPACT_TIME + 0.5
#define FLY_TIME 2.85


quibble_point_2D rotate_about_origin(quibble_point_2D pt, float theta){

    float v1 = pt.x*cos(theta) - pt.y*sin(theta);
    float v2 = pt.x*sin(theta) + pt.y*cos(theta);

    return qb_point_2D(v1, v2);

}

__poem bg_layer(quibble_pixels_prgba8888 qpix,
                quibble_simple_camera qcam, float time){
    quibble_point_2D pt = qb_find_point_location(_idx, qcam);

    quibble_pcolor_rgba8888 qcolor = qb_pcolor_rgba8888(1,1,1,1,1);

    float ball_velocity = 10;
    quibble_point_2D sun_position = qb_point_2D(-1,-6);
    float sun_radius;
    float ratio;

    //printf("%d\n", pt.y);
    if (time < CENTER_TIME || time > HIT_TIME){
        ratio = 1 - ((pt.y + 4) / 8);
        if (pt.y > 2){
            qcolor = qb_pcolor_rgba8888(0.25,0.75,0.25,1, 0.1);
        }
        else {
            // 0 at top, 1 at bottom
            //printf("%d\t%d\n", ratio, pt.y);
            qcolor = qb_pcolor_rgba8888((1-ratio*0.75),
                                        (1-ratio*0.75),
                                        1,1,0.1);
        }
    }
    else if (time >= CENTER_TIME && time < APEX_TIME){
        ratio = 1 - ((pt.y - ball_velocity*(time-CENTER_TIME) + 4) / 8);
        sun_radius = sqrt((pt.x-sun_position.x)*(pt.x-sun_position.x)+
                          (pt.y-(ball_velocity*(time-CENTER_TIME))-sun_position.y)*(pt.y-(ball_velocity*(time-CENTER_TIME))-sun_position.y));
        if (pt.y > 2 + ball_velocity*(time - CENTER_TIME)){
            qcolor = qb_pcolor_rgba8888(0.25,0.75,0.25,1, 0.1);
        }
        else {
            sun_radius = sqrt((pt.x-sun_position.x)*(pt.x-sun_position.x)+
                              (pt.y-(ball_velocity*(time-CENTER_TIME))-sun_position.y)*(pt.y-(ball_velocity*(time-CENTER_TIME))-sun_position.y));
            // 1 at top, 0 at bottom
            //printf("%f\t%f\n", sun_radius, pt.y);
            if (sun_radius > 2){
                qcolor = qb_pcolor_rgba8888((1-ratio*0.75),
                                            (1-ratio*0.75),
                                            1,1,0.1);
            }
            else{
                qcolor = qb_pcolor_rgba8888((1-ratio*0.75) + (1 - sun_radius/2),
                                            (1-ratio*0.75) + (1 - sun_radius/2),
                                            1,1,0.1);
            }
        }

    }
    else if (time >= APEX_TIME && time < APEX_TIME + HANG_TIME){
        ratio = 1 - ((pt.y - ball_velocity*(APEX_TIME-CENTER_TIME) + 4) / 8);
        sun_radius = sqrt((pt.x-sun_position.x)*(pt.x-sun_position.x)+
                          (pt.y-(ball_velocity*(APEX_TIME-CENTER_TIME))-sun_position.y)*(pt.y-(ball_velocity*(APEX_TIME-CENTER_TIME))-sun_position.y));
        // 1 at top, 0 at bottom
        //printf("%f\t%f\n", sun_radius, pt.y);
        if (sun_radius > 2){
            qcolor = qb_pcolor_rgba8888((1-ratio*0.75),
                                        (1-ratio*0.75),
                                        1,1,0.1);
        }
        else{
            qcolor = qb_pcolor_rgba8888((1-ratio*0.75) + (1 - sun_radius/2),
                                        (1-ratio*0.75) + (1 - sun_radius/2),
                                        1,1,0.1);
        }

    }
    else if (time >= APEX_TIME+HANG_TIME && time < HIT_TIME){
        // 0.5 => fall time is 2x rising time
        ratio = 1 - ((pt.y - ball_velocity*(APEX_TIME-CENTER_TIME)+0.5*ball_velocity*(time-APEX_TIME-HANG_TIME) + 4) / 8);
        sun_radius = sqrt((pt.x-sun_position.x)*(pt.x-sun_position.x)+
                          (pt.y-(ball_velocity*(APEX_TIME-CENTER_TIME))+(ball_velocity*(time-APEX_TIME-HANG_TIME))-sun_position.y)*(pt.y-(ball_velocity*(APEX_TIME-CENTER_TIME))+(ball_velocity*(time-APEX_TIME-HANG_TIME))-sun_position.y));
        if (pt.y > 2 + ball_velocity*(2*APEX_TIME + HANG_TIME - time)){
            qcolor = qb_pcolor_rgba8888(0.25,0.75,0.25,1, 0.1);
        }
        else {
            // 1 at top, 0 at bottom
            //printf("%f\t%f\n", sun_radius, pt.y);
            if (sun_radius > 2){
                qcolor = qb_pcolor_rgba8888((1-ratio*0.75),
                                            (1-ratio*0.75),
                                            1,1,0.1);
            }
            else{
                qcolor = qb_pcolor_rgba8888((1-ratio*0.75) + (1 - sun_radius/2),
                                            (1-ratio*0.75) + (1 - sun_radius/2),
                                            1,1,0.1);
            }
        }

    }
    else{
        float ratio = (pt.y + 4) / 8;
        qcolor = qb_pcolor_rgba8888(ratio * 0.25, ratio * 0.25, ratio,1,0);
    }
    histogram_overwrite_prgba8888(pt, qcolor, qcam, qpix);
}

// Center of screen at 0.5 seconds
// apex @ 2 seconds
__verse ball_smear(quibble_point_2D pt, 
                   quibble_pcolor_rgba8888 clr,
                   float time){

/*
    float center_time = 0.5;
    float apex_time = 1;
    float hang_time = 0.5;
    float hit_time = apex_time + hang_time + 1;
    float impact_time = 0.25;
    float fly_time = hit_time + impact_time + 0.5;
*/
    float ratio;

    if (time <= CENTER_TIME){
        pt.y += 5 - 5*(time / CENTER_TIME);
    }

    if (time <= APEX_TIME){
        pt.y *= 3 - 2*(time/APEX_TIME);
    }

    if (time > APEX_TIME + HANG_TIME &&
        time < HIT_TIME){
        ratio = (time - (APEX_TIME + HANG_TIME))/(HIT_TIME - ((APEX_TIME + HANG_TIME)));
        pt.y *= 1 + 2*ratio;
        pt.x *= 1 - 0.5*ratio;
        pt.y *= 1 - 0.5*ratio;
    }

    if (time >= HIT_TIME &&
        time < HIT_TIME + IMPACT_TIME){
        pt.y *= 3;
        pt.x *= 0.5;
        pt.y *= 0.5;
        ratio = (time - HIT_TIME) / (IMPACT_TIME);
        pt.x += 0.5 * pt.y*pt.y*ratio;
        pt.x -= ratio;

        pt = rotate_about_origin(pt, 0.15*M_PI*ratio);

    }
    if (time >= HIT_TIME + IMPACT_TIME){
        pt.y *= 3;
        pt.x *= 0.5;
        pt.y *= 0.5;
        pt.x += 0.5 * pt.y*pt.y;
        pt.x -= 1;

        pt.x -= 15*(time - IMPACT_TIME - HIT_TIME);
        pt.y -= 4*(time - IMPACT_TIME - HIT_TIME);

        pt = rotate_about_origin(pt, 0.15*M_PI);

    }

    histogram_output_prgba8888(pt, clr, qcam, qpix);
}

__verse bat_smear(quibble_point_2D pt, 
                  quibble_pcolor_rgba8888 clr,
                  float time){

    float swing_time = 1;
    float start_time = HIT_TIME-0.5*swing_time;

    // Forming the initial bat structure
    if (pt.y > 0){
        pt.x /= (1+0.75*(pt.y));
    }

    // Adding velocity smear
    pt.y -= 2;
    pt = rotate_about_origin(pt, 0.15*M_PI*(pt.x+0.25));
    pt = rotate_about_origin(pt, -0.01*M_PI*(pt.y+0.25));
    pt.y += 2;

    //rotating
    if (time >= start_time){
        pt.y -= 2;
        //pt = rotate_about_origin(pt, -0.2*M_PI + 0.5*M_PI-0.25*M_PI*(time-start_time)/swing_time);
        pt = rotate_about_origin(pt, 0.5*M_PI-0.7*M_PI*(time-start_time)/swing_time);

        pt.y += 4;
        pt.x -= 2;
    
        histogram_output_prgba8888(pt, clr, qcam, qpix);
    }
}
__poem ball_motion(quibble_pixels_prgba8888 qpix,
                   quibble_simple_camera qcam, float time){

    quibble_pcolor_rgba8888 qcolor = qb_pcolor_rgba8888(1,1,1,1,1);

    @SCALL circle_chaos(2000, qcam, qcolor |
                        radius = 1;){
        @VCALL ball_smear(_pt, qcolor, time);
    }

    if (time >= HIT_TIME-1){
        @SCALL rectangle_chaos(2000, qcam, qcolor |
                               scale_y = 3; scale_x = 0.25;){
            @VCALL bat_smear(_pt, qcolor, time);
        }
    }
}
